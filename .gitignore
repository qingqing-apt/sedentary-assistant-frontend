node_modules/
dist/
.env
.env.local
*.local
.DS_Store

# Capacitor / Android 构建产物
# release/ 下只保留 APK：安装包跟着分支走，别人拉下来就能直接装，不用自己配 JDK 21 + SDK 重新打包。
# 其余（调试截图等）仍然忽略。
release/*
!release/*.apk

# Playwright
test-results/
playwright-report/
blob-report/

# CopilotKit 线程历史（落盘文件，不进仓库）
.runtime-data/

# 部署运行期数据：证书、备份、版本记录都不进 Git
deploy/certs/
deploy/backups/
deploy/state/
deploy/.env
