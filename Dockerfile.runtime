# syntax=docker/dockerfile:1
# CopilotKit Runtime：把前端的 /api/copilotkit 转发成 AG-UI 流给 Python Agent
FROM node:22-slim

ENV NODE_ENV=production \
    COPILOT_RUNTIME_PORT=3000 \
    AGENT_URL=http://api:8000/api/agent/chat \
    THREADS_DIR=/app/.runtime-data/threads

WORKDIR /app

COPY package.json package-lock.json ./

# tsx 在 package.json 里是 devDependency，`npm ci --omit=dev` 会把它剪掉。
# 这里装成全局命令：不参与项目的 prod/dev 裁剪，也不改动 lockfile。
# 更彻底的做法是把 tsx 移进 dependencies，届时删掉这一行即可。
RUN npm ci --omit=dev --no-audit --no-fund \
    && npm install -g --no-audit --no-fund tsx@4.23.15

COPY runtime ./runtime

# 对话历史落盘目录：命名卷首次挂载会继承这里的属主
RUN mkdir -p /app/.runtime-data && chown -R node:node /app/.runtime-data

USER node

EXPOSE 3000

# 端口级探活。等 server.ts 加上 /health 后换成 HTTP 探测，才能区分“占着端口”和“服务可用”
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
    CMD node -e "const s=require('net').connect(3000,'127.0.0.1');s.on('connect',()=>{s.end();process.exit(0)});s.on('error',()=>process.exit(1))"

CMD ["tsx", "runtime/server.ts"]
