# syntax=docker/dockerfile:1
# CopilotKit Runtime：把前端的 /api/copilotkit 转发成 AG-UI 流给 Python Agent
FROM node:22-slim

ENV NODE_ENV=production \
    COPILOT_RUNTIME_PORT=3000 \
    AGENT_URL=http://api:8000/api/agent/chat \
    THREADS_DIR=/app/.runtime-data/threads

WORKDIR /app

COPY package.json package-lock.json ./

# tsx 在 dependencies 里（生产启动要用），--omit=dev 不会剪掉它
RUN npm ci --omit=dev --no-audit --no-fund

COPY runtime ./runtime

# 对话历史落盘目录：命名卷首次挂载会继承这里的属主
RUN mkdir -p /app/.runtime-data && chown -R node:node /app/.runtime-data

USER node

EXPOSE 3000

# HTTP 探活：能区分「占着端口」和「服务真的能应答」
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
    CMD node -e "fetch('http://127.0.0.1:3000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node_modules/.bin/tsx", "runtime/server.ts"]
